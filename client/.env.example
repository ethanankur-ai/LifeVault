# Copy to .env and fill in. These end up in the browser bundle, so only public values go here.

# Supabase dashboard → Project Settings → API (the anon / publishable key, NOT the service key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Where the Express API runs
VITE_API_URL=http://localhost:4000
