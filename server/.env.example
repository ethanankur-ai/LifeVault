# Copy this file to .env and fill it in. Never commit .env: the service key is an admin password.

# Supabase dashboard → Project Settings → API (use the service_role / secret key, not the anon one)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-or-secret-key

# Recommended: the anon / publishable key (same dashboard page). Requests made on a user's behalf use it, so they can never run with admin rights.
SUPABASE_ANON_KEY=

# Optional: turns on /api/extract auto-fill. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

PORT=4000

# The frontend's address, allowed by CORS. Local default: http://localhost:5173. On Vercel: the frontend URL (no trailing slash)
CLIENT_ORIGIN=
